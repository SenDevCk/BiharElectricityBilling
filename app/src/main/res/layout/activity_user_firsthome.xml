<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fadingEdge="horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLastVisit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/textView1"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="5dp"
            android:gravity="center_horizontal"
            android:text="Last Visit"
            android:textColor="#3E22F2"
            android:textSize="15sp"
            android:visibility="gone" />

        <include
            android:id="@+id/footer"
            layout="@layout/footer"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@drawable/pole"
            android:descendantFocusability="beforeDescendants"
            android:fadingEdge="horizontal"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin">

            <LinearLayout
                android:id="@+id/mainLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="5dp"
                    android:gravity="left"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:src="@drawable/back11">

                    <TextView
                        android:id="@+id/textName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="2dp"
                        android:text="Name"
                        android:textColor="@android:color/holo_blue_light"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:text="it's one time mandatory to update consumer's  address ."
                        android:textColor="@android:color/holo_blue_light"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textDist1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:text="उपभोक्ता के पते को अपडेट करने के लिए यह एक बार अनिवार्य है |"
                        android:textColor="@android:color/holo_blue_light"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lin_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back1"
                    android:orientation="vertical"
                    android:padding="7dp">

                    <TextView
                        android:id="@+id/district"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="जिला"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spinnerdistrict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#43D305"
                        android:background="#F1F38B"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back1"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:paddingTop="0dp">

                    <TextView
                        android:id="@+id/block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="left"
                        android:text="प्रखंड"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerblock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#43D305"
                        android:background="#F1F38B"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_panchayat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back1"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/panchayat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="7dp"
                        android:gravity="left"
                        android:text="पंचायत"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerpanchayatnew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#43D305"
                        android:background="#F1F38B"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_village"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back1"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:paddingTop="0dp">

                    <TextView
                        android:id="@+id/village"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="left"
                        android:text="गाँव"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnervillagenew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#43D305"
                        android:background="#F1F38B"                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_tola"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back1"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:paddingTop="0dp">
                    <TextView
                        android:id="@+id/tola"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="टोला / वार्ड "
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spinnertolanew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#43D305"
                        android:background="#F1F38B"                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/back11"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="7dp"
                    android:paddingTop="0dp">

                    <Button
                        android:id="@+id/btnNewMeterConnection"
                        android:layout_width="wrap_content"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:layout_margin="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_cornergreend"
                        android:drawableLeft="@drawable/doness"
                        android:onClick="onClickNewMeterConnection"
                        android:padding="5dp"
                        android:text="सेव एंड कंटिन्यू "
                        android:textAllCaps="false"
                        android:textColor="#fdfbfb"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnrefresh"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_gravity="right"
                        android:layout_margin="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_cornergreend"
                        android:onClick="onClickrefresh"
                        android:padding="5dp"
                        android:text="डेटा रीफ्रेश करें"
                        android:textAllCaps="false"
                        android:textColor="#fdfbfb"
                        android:textStyle="bold"
                        android:visibility="gone" />
                    <!--<Button-->
                    <!--android:id="@+id/btnMeterReplacement"-->
                    <!--android:layout_width="250dp"-->
                    <!--android:layout_height="75dp"-->
                    <!--android:layout_alignParentLeft="true"-->
                    <!--android:onClick="onClickMeterReplacement"-->
                    <!--android:layout_marginTop="20dp"-->
                    <!--android:padding="5dp"-->
                    <!--android:background="@drawable/rounded_cornergreend"-->
                    <!--android:textColor="#fcfbfb"-->
                    <!--android:textStyle="bold"-->
                    <!--android:textAllCaps="false"-->
                    <!--android:drawableLeft="@drawable/oldmeterm"-->
                    <!--android:drawableRight="@drawable/newmetermn"-->
                    <!--android:text="Meter Replacement or New Installation"/>-->

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>