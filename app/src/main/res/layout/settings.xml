<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pole1"
    android:orientation="vertical"
   >
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"    />
     <TextView 
    android:id="@+id/bluetoothstate" 
    android:layout_width="fill_parent"
         android:text="Bluetooth State"
         android:gravity="center"
         android:textColor="#FFFFFF"
    android:layout_height="wrap_content" 
    />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bluetooth Address"  />
   <TextView
		android:id="@+id/btaddTV"      
   		 android:layout_width="wrap_content"
       	 android:layout_height="wrap_content"
    />
<EditText
        android:id="@+id/bluetoothAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         >
    </EditText>
<Button
    android:id="@+id/scandevice" 
    android:layout_width="fill_parent" 
    android:layout_height="52dp"
    android:background="@drawable/back12"
    android:textColor="@android:color/background_light"
    android:text="@string/btn_restart" />
    <Button
        android:id="@+id/backBtnSET"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="   BACK   " />
    
    <ListView
         android:id="@+id/devicesfound" 
         android:layout_width="fill_parent" 
         android:layout_height="fill_parent">
    </ListView>"
</LinearLayout>