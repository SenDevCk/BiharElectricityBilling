<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rel"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/pole"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:gravity="center_vertical|center_horizontal">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:baselineAligned="false"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/no_of_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/darker_gray"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mruName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#A85221"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/horscroll_view1"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TableLayout
                        android:id="@+id/tableLayoutrep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp" >

                        <TableRow
                            android:id="@+id/tableRow1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="1dp"
                            android:gravity="center_horizontal" >

                            <TextView
                                android:id="@+id/textView11"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_span="4"
                                android:background="@drawable/cell_shape"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="UNBILLED CONSUMER LIST REPORT"
                                android:textColor="#FFFFFF"
                                android:textSize="20dp"
                                android:textStyle="bold" >
                            </TextView>
                        </TableRow>

                        <TableRow
                            android:id="@+id/tbleRow2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="1dp" >

                            <TextView
                                android:id="@+id/TxtView21"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  MRU NUMBER  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView22"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  BILLED  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView23"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  UNBILLED  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView24"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  TOTAL  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/horscroll_view2"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ScrollView
                android:id="@+id/scroll_view2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TableLayout
                        android:id="@+id/tableLayoutrep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp" >

                        <TableRow
                            android:id="@+id/tableRow2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="1dp"
                            android:gravity="center_horizontal" >

                            <TextView
                                android:id="@+id/textView21"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_span="3"
                                android:background="@drawable/cell_shape"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text=" UNBILLED CONSUMER LIST "
                                android:textColor="#FFFFFF"
                                android:textSize="20dp"
                                android:textStyle="bold" >
                            </TextView>
                        </TableRow>

                        <TableRow
                            android:id="@+id/tbleRow3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="1dp" >

                            <TextView
                                android:id="@+id/TxtView31"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  ACCOUNT NO.  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView31A"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  Category  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView32"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text=" CONSUMER NAME "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView34"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  Father's Name  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                            <TextView
                                android:id="@+id/TxtView33"
                                android:background="@drawable/cell_shape1"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="  ADDRESS  "
                                android:textColor="#FBFF46"
                                android:textSize="14dp"
                                android:textStyle="bold"
                                android:typeface="serif" >
                            </TextView>

                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>